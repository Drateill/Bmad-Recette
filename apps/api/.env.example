# Application
NODE_ENV=development
PORT=3001
API_VERSION=0.1.0

# Database
DATABASE_URL=postgresql://bmad:dev_password@localhost:5432/bmad_recette_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Security
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
JWT_SECRET=your-secret-key-here-change-in-production
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=7d

# Logging
LOG_LEVEL=debug

# OAuth - Google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# OAuth - Apple
APPLE_CLIENT_ID=com.bmadrecette.signin
APPLE_TEAM_ID=ABC123XYZ
APPLE_KEY_ID=KEY123ABC
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC...
APPLE_CALLBACK_URL=http://localhost:3001/api/auth/apple/callback

# Frontend
FRONTEND_URL=http://localhost:5173

# AWS S3 Configuration
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_BUCKET_NAME=bmad-recette-dev
S3_CDN_URL=

# Staging Environment Variables (for reference - set in Railway dashboard)
# NODE_ENV=staging
# DATABASE_URL=<provided-by-railway>
# REDIS_URL=<provided-by-railway>
# JWT_SECRET=<generate-with-crypto.randomBytes(32).toString('hex')>
# JWT_REFRESH_SECRET=<generate-different-secret>
# FRONTEND_URL=https://<your-vercel-url>.vercel.app
# GOOGLE_CALLBACK_URL=https://bmad-recette-production.up.railway.app/api/auth/google/callback
# APPLE_CALLBACK_URL=https://bmad-recette-production.up.railway.app/api/auth/apple/callback
